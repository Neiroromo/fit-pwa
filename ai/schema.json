{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "fit-pwa-ai.schema.json",
  "title": "Fit: файл от ИИ (fit-pwa-ai v1)",
  "type": "object",
  "required": [
    "format",
    "version",
    "generatedBy"
  ],
  "anyOf": [
    {
      "required": [
        "exercises"
      ]
    },
    {
      "required": [
        "foods"
      ]
    },
    {
      "required": [
        "workouts"
      ]
    },
    {
      "required": [
        "mealPlan"
      ]
    }
  ],
  "properties": {
    "format": {
      "const": "fit-pwa-ai"
    },
    "version": {
      "const": 1
    },
    "generatedBy": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    },
    "createdAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "note": {
      "type": "string",
      "maxLength": 500
    },
    "exercises": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": [
          "name",
          "groups"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "groups": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 30
            }
          },
          "equipment": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 30
            }
          },
          "muscles": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 30
            }
          },
          "secondary": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 30
            }
          },
          "level": {
            "enum": [
              "beginner",
              "intermediate",
              "expert"
            ]
          },
          "steps": {
            "type": "array",
            "maxItems": 12,
            "items": {
              "type": "string",
              "maxLength": 300
            }
          }
        }
      }
    },
    "foods": {
      "type": "array",
      "maxItems": 300,
      "items": {
        "type": "object",
        "required": [
          "name",
          "unit",
          "kcal",
          "protein",
          "fat",
          "carbs"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "unit": {
            "enum": [
              "g",
              "ml"
            ]
          },
          "kcal": {
            "type": "number",
            "minimum": 0,
            "maximum": 900
          },
          "protein": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "fat": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "carbs": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "fiber": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "sugar": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "portion": {
            "type": "object",
            "required": [
              "size",
              "name"
            ],
            "properties": {
              "size": {
                "type": "number",
                "minimum": 1,
                "maximum": 5000
              },
              "name": {
                "type": "string",
                "maxLength": 20
              }
            }
          }
        }
      }
    },
    "workouts": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "required": [
          "name",
          "exercises"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "exercises": {
            "type": "array",
            "minItems": 1,
            "maxItems": 30,
            "items": {
              "type": "object",
              "required": [
                "name",
                "sets"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                },
                "sets": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10
                },
                "comment": {
                  "type": "string",
                  "maxLength": 300
                },
                "warmup": {
                  "type": "boolean"
                }
              }
            }
          },
          "days": {
            "type": "array",
            "maxItems": 7,
            "items": {
              "enum": [
                "mon",
                "tue",
                "wed",
                "thu",
                "fri",
                "sat",
                "sun"
              ]
            }
          }
        }
      }
    },
    "mealPlan": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "required": [
          "date",
          "meal",
          "items"
        ],
        "properties": {
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "meal": {
            "type": "string",
            "minLength": 1,
            "maxLength": 30
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "type": "object",
              "required": [
                "food",
                "amount"
              ],
              "properties": {
                "food": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                },
                "amount": {
                  "type": "number",
                  "minimum": 1,
                  "maximum": 3000
                }
              }
            }
          }
        }
      }
    }
  }
}
